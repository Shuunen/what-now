{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "background_color": "#084e91",
  "description": "Minimalist task reminder",
  "display": "fullscreen",
  "icons": [
    {
      "sizes": "64x64",
      "src": "/pwa-64x64.png",
      "type": "image/png"
    },
    {
      "sizes": "192x192",
      "src": "/pwa-192x192.png",
      "type": "image/png"
    },
    {
      "sizes": "512x512",
      "src": "/pwa-512x512.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "sizes": "512x512",
      "src": "/maskable-icon-512x512.png",
      "type": "image/png"
    }
  ],
  "name": "What Now ?",
  "scope": "/",
  "short_name": "What Now ?",
  "start_url": "/",
  "theme_color": "#0c7ade"
}
